{
  "services": [
    {
      "name": "neko",
      "image": "m1k1o/neko:brave",
      "environment": {
        "NEKO_SCREEN": "1920x1080@30",
        "NEKO_PASSWORD": "yang",
        "NEKO_PASSWORD_ADMIN": "babi",
        "NEKO_EPR": "52000-52100",
        "NEKO_ICELITE": 1
      },
      "internalPort": 8080,
      "addPorts": [
        {
          "containerPort": 52000,
          "hostPort": 52000,
          "tcp": false,
          "udp": true
        }
      ],
      "capAdd": [
        "SYS_ADMIN"
      ],
      "shmSize": "4gb"
    }
  ]
}